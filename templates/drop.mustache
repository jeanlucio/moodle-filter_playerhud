{{!
    @template filter_playerhud/drop

    Renders a drop collection trigger (Card, Text, or Image mode).
    @package    block_playerhud
    @copyright  2026 Jean Lúcio
    @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "id": 123,
        "token": "abc123token",
        "collected": false,
        "is_image": true,
        "image_url": "http://example.com/item.png",
        "name": "Hidden Treasure"
    }
}}

{{! --- MODE: TEXT --- }}
{{#is_text}}
    {{#limit_reached}}
        <span class="ph-item-details-trigger text-success fw-bold ph-cursor-help d-inline-flex align-items-center gap-1"
              tabindex="0"
              role="button"
              aria-disabled="true"
              {{{data_attributes}}}>
            <i class="fa fa-check" aria-hidden="true"></i>
            <span class="visually-hidden">{{#str}} collected, filter_playerhud {{/str}}: </span>{{label}}
        </span>
    {{/limit_reached}}
    {{^limit_reached}}
        {{#is_cooldown}}
            <span class="ph-item-details-trigger ph-text-dimmed ph-cursor-wait d-inline-flex align-items-center gap-1"
                  tabindex="0"
                  role="button"
                  aria-disabled="true"
                  {{{data_attributes}}}>
                <span aria-hidden="true">⏳</span>
                <span class="visually-hidden">{{#str}} wait, filter_playerhud {{/str}}: </span>{{label}}
                <small class="ph-timer ms-1" data-deadline="{{readytime}}">
                    {{#str}} loading, filter_playerhud {{/str}}
                </small>
            </span>
        {{/is_cooldown}}
        {{^is_cooldown}}
            <a href="{{collect_url}}"
               class="ph-action-collect fw-bold d-inline-flex align-items-center gap-1"
               data-mode="text"
               {{{data_attributes}}}>
               {{label}}
            </a>
        {{/is_cooldown}}
    {{/limit_reached}}
{{/is_text}}

{{! --- MODE: IMAGE --- }}
{{#is_image_mode}}
    <div class="ph-drop-image-container
                {{#limit_reached}}ph-item-details-trigger ph-cursor-help{{/limit_reached}}
                {{#is_cooldown}}ph-item-details-trigger ph-cursor-wait{{/is_cooldown}}"
         {{#limit_reached}}role="button" tabindex="0" aria-disabled="true"{{/limit_reached}}
         {{#is_cooldown}}role="button" tabindex="0" aria-disabled="true"{{/is_cooldown}}
         {{{data_attributes}}}>

        {{! Hidden text for screen reader to provide context to the icon }}
        {{#limit_reached}}
            <span class="visually-hidden">{{safe_name}} - {{#str}} collected, filter_playerhud {{/str}}</span>
        {{/limit_reached}}
        {{#is_cooldown}}
            <span class="visually-hidden">{{safe_name}} - {{#str}} wait, filter_playerhud {{/str}}: </span>
        {{/is_cooldown}}

        <div class="{{#limit_reached}}ph-state-grayscale{{/limit_reached}} {{#is_cooldown}}ph-state-dimmed{{/is_cooldown}}">
            {{#is_image_media}}
                <img src="{{media_url}}" class="ph-drop-img-lg rounded-0" alt="">
            {{/is_image_media}}
            {{^is_image_media}}
                <span class="ph-drop-emoji-lg" aria-hidden="true">{{{media_content}}}</span>
            {{/is_image_media}}
        </div>

        {{#limit_reached}}
            <span class="badge bg-success rounded-circle ph-badge-bottom-right" aria-hidden="true">
                <i class="fa fa-check"></i>
            </span>
        {{/limit_reached}}

        {{#is_cooldown}}
            <div class="ph-timer badge bg-light text-dark border shadow-sm ph-badge-bottom-center"
                 data-deadline="{{readytime}}"
                 data-no-label="1">
                {{#str}} loading, filter_playerhud {{/str}}
            </div>
        {{/is_cooldown}}

        {{^limit_reached}}{{^is_cooldown}}
            <a href="{{collect_url}}"
               class="ph-action-collect ph-hover-scale ph-link-overlay"
               aria-label="{{#str}} take, filter_playerhud {{/str}}: {{safe_name}}"
               data-mode="image"
               {{{data_attributes}}}>
            </a>
        {{/is_cooldown}}{{/limit_reached}}
    </div>
{{/is_image_mode}}

{{! --- MODE: CARD (Default) --- }}
{{#is_card}}
    <div class="playerhud-item-card ph-card-compact card p-2 ph-drop-card-container d-inline-flex {{#limit_reached}}ph-owned{{/limit_reached}}"
         {{{data_attributes}}}>

        {{! Icon/Trigger Area }}
        <div class="ph-item-details-trigger ph-drop-trigger-area"
             tabindex="0"
             role="button"
             aria-label="{{#str}} details, block_playerhud {{/str}}: {{safe_name}}">

             <div class="ph-drop-icon-wrapper">
                 {{#is_image_media}}
                     <img src="{{media_url}}" alt="" class="rounded-0">
                 {{/is_image_media}}
                 {{^is_image_media}}
                    <div class="ph-icon-large" aria-hidden="true">{{{media_content}}}</div>
                 {{/is_image_media}}
             </div>

             <strong class="text-center d-block text-truncate w-100 ph-text-small" aria-hidden="true">
                {{display_name}}
             </strong>
        </div>

        {{! Button State }}
        {{#limit_reached}}
            <button type="button" class="btn btn-light btn-sm w-100 text-success border-success disabled" aria-disabled="true">
                <i class="fa fa-check" aria-hidden="true"></i>
                <span class="visually-hidden">{{safe_name}}: </span>{{#str}} collected, filter_playerhud {{/str}}
            </button>
        {{/limit_reached}}

        {{^limit_reached}}
            {{#is_cooldown}}
                <button type="button" class="btn btn-light btn-sm w-100 ph-text-dimmed disabled" aria-disabled="true">
                    <span aria-hidden="true">⏳</span>
                    <span class="visually-hidden">{{#str}} wait, filter_playerhud {{/str}} {{safe_name}}: </span>
                    <span class="ph-timer" data-deadline="{{readytime}}">{{#str}} loading, filter_playerhud {{/str}}</span>
                </button>
            {{/is_cooldown}}

            {{^is_cooldown}}
                <a href="{{collect_url}}"
                   class="btn btn-primary btn-sm w-100 ph-action-collect shadow-sm mt-2"
                   data-mode="card">
                   {{{emoji_html}}} <span class="visually-hidden">{{safe_name}}: </span>{{btn_text}}
                </a>
            {{/is_cooldown}}
        {{/limit_reached}}
    </div>
{{/is_card}}
