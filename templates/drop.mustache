{{!
    @template filter_playerhud/drop
    Renders a drop collection trigger (Card, Text, or Image mode).
    COMPLIANCE: No inline styles.
}}

{{! --- MODE: TEXT --- }}
{{#is_text}}
    {{#limit_reached}}
        <span class="ph-item-details-trigger text-success fw-bold ph-cursor-help" 
              tabindex="0" 
              role="button" 
              {{{data_attributes}}}>
            <i class="fa fa-check" aria-hidden="true"></i> {{label}}
        </span>
    {{/limit_reached}}
    {{^limit_reached}}
        {{#is_cooldown}}
            <span class="ph-item-details-trigger text-muted ph-cursor-wait" 
                  tabindex="0" 
                  role="button" 
                  {{{data_attributes}}}>
                ⏳ {{label}} <small class="ph-timer" data-deadline="{{readytime}}">...</small>
            </span>
        {{/is_cooldown}}
        {{^is_cooldown}}
            <a href="{{collect_url}}" 
               class="ph-action-collect fw-bold" 
               data-mode="text" 
               {{{data_attributes}}}>
               {{label}}
            </a>
        {{/is_cooldown}}
    {{/limit_reached}}
{{/is_text}}

{{! --- MODE: IMAGE --- }}
{{#is_image_mode}}
    <div class="ph-drop-image-container" 
         {{! ... atributos do container ... }}
         {{{data_attributes}}}>

        {{! Content Wrapper ... }}
        <div class="{{#limit_reached}}ph-state-grayscale{{/limit_reached}} {{#is_cooldown}}ph-state-dimmed{{/is_cooldown}}">
            {{#is_image_media}}
                <img src="{{media_url}}" class="ph-drop-img-lg" alt="{{safe_name}}">
            {{/is_image_media}}
            {{^is_image_media}}
                <span class="ph-drop-emoji-lg" aria-hidden="true">{{{media_content}}}</span>
            {{/is_image_media}}
        </div>

        {{! Badges ... }}
        {{#limit_reached}}
            <span class="badge bg-success rounded-circle ph-badge-bottom-right">
                <i class="fa fa-check" aria-hidden="true"></i>
            </span>
        {{/limit_reached}}
        
        {{#is_cooldown}}
            {{! MUDANÇA AQUI: Adicionado data-no-label="1" para remover o texto longo }}
            <div class="ph-timer badge bg-light text-dark border shadow-sm ph-badge-bottom-center" 
                 data-deadline="{{readytime}}"
                 data-no-label="1">...</div>
        {{/is_cooldown}}

        {{! Action Link ... }}
        {{^limit_reached}}{{^is_cooldown}}
            <a href="{{collect_url}}" 
               class="ph-action-collect ph-hover-scale ph-link-overlay" 
               aria-label="{{#str}} take, block_playerhud {{/str}}: {{safe_name}}"
               data-mode="image" 
               {{{data_attributes}}}>
            </a>
        {{/is_cooldown}}{{/limit_reached}}
    </div>
{{/is_image_mode}}

{{! --- MODE: CARD (Default) --- }}
{{#is_card}}
    {{! Container Class: ph-drop-card-container replaces inline width/margin }}
    <div class="playerhud-item-card ph-card-compact card p-2 ph-drop-card-container {{#limit_reached}}ph-owned{{/limit_reached}}" 
         {{{data_attributes}}}>
        
        {{! Badge Count }}
{{! MUDANÇA: Usamos a classe d-none condicionalmente em vez de style inline }}
<span class="badge bg-info text-dark rounded-pill ph-badge-top-right ph-badge-count {{^count}}d-none{{/count}}">
              x{{count}}
        </span>

        {{! Icon/Trigger Area }}
        <div class="ph-item-details-trigger ph-drop-trigger-area" 
             tabindex="0" 
             role="button" 
             aria-label="{{#str}} details, block_playerhud {{/str}}: {{safe_name}}">
             
             <div class="ph-drop-icon-wrapper">
                 {{#is_image_media}}
                    <img src="{{media_url}}" alt="">
                 {{/is_image_media}}
                 {{^is_image_media}}
                    <div style="font-size:2.5em; line-height:1;" aria-hidden="true">{{{media_content}}}</div>
                 {{/is_image_media}}
             </div>

             <strong class="text-center d-block text-truncate w-100 ph-text-truncate-100" style="font-size: 0.9rem;" aria-hidden="true">
                {{display_name}}
             </strong>
        </div>
        
        {{! Button State }}
        {{#limit_reached}}
            <button disabled class="btn btn-light btn-sm w-100 text-success border-success">
                <i class="fa fa-check" aria-hidden="true"></i> {{#str}} collected, block_playerhud {{/str}}
            </button>
        {{/limit_reached}}
        {{^limit_reached}}
            {{#is_cooldown}}
                <button disabled class="btn btn-light btn-sm w-100 text-muted">
                    ⏳ <span class="ph-timer" data-deadline="{{readytime}}">...</span>
                </button>
            {{/is_cooldown}}
            {{^is_cooldown}}
                <a href="{{collect_url}}" 
                   class="btn btn-primary btn-sm w-100 ph-action-collect shadow-sm mt-2" 
                   data-mode="card">
                   {{{emoji_html}}}{{btn_text}}
                </a>
            {{/is_cooldown}}
        {{/limit_reached}}
    </div>
{{/is_card}}
