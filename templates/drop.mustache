{{!
    @template filter_playerhud/drop
    Renders a drop collection trigger (Card, Text, or Image mode).
}}

{{! --- MODE: TEXT --- }}
{{#is_text}}
    {{#limit_reached}}
        <span class="ph-item-details-trigger text-success fw-bold" 
              style="cursor:help;" 
              tabindex="0" 
              role="button" 
              {{{data_attributes}}}>
            <i class="fa fa-check" aria-hidden="true"></i> {{label}}
        </span>
    {{/limit_reached}}
    {{^limit_reached}}
        {{#is_cooldown}}
            <span class="ph-item-details-trigger text-muted" 
                  style="cursor:wait;" 
                  tabindex="0" 
                  role="button" 
                  {{{data_attributes}}}>
                ⏳ {{label}} <small class="ph-timer" data-deadline="{{readytime}}">...</small>
            </span>
        {{/is_cooldown}}
        {{^is_cooldown}}
            <a href="{{collect_url}}" 
               class="ph-action-collect fw-bold" 
               data-mode="text" 
               {{{data_attributes}}}>
               {{label}}
            </a>
        {{/is_cooldown}}
    {{/limit_reached}}
{{/is_text}}

{{! --- MODE: IMAGE --- }}
{{#is_image_mode}}
    <div style="display:inline-block; position:relative; text-align:center;" 
         {{#limit_reached}}
             class="ph-item-details-trigger" 
             tabindex="0" 
             role="button" 
             title="{{#str}} collected, block_playerhud {{/str}}"
         {{/limit_reached}}
         {{#is_cooldown}}
             class="ph-item-details-trigger" 
             tabindex="0" 
             role="button"
         {{/is_cooldown}}
         {{{data_attributes}}}>

        {{! Content Wrapper }}
        <div style="{{#limit_reached}}opacity:0.5; filter:grayscale(100%);{{/limit_reached}}{{#is_cooldown}}opacity:0.5;{{/is_cooldown}}">
            {{#is_image_media}}
                <img src="{{media_url}}" style="width:50px; height:50px; object-fit:contain;" alt="{{safe_name}}">
            {{/is_image_media}}
            {{^is_image_media}}
                <span style="font-size:40px;" aria-hidden="true">{{{media_content}}}</span>
            {{/is_image_media}}
        </div>

        {{! Badges }}
        {{#limit_reached}}
            <span class="badge bg-success rounded-circle" style="position:absolute; bottom:-5px; right:-5px; font-size:0.6rem;">
                <i class="fa fa-check" aria-hidden="true"></i>
            </span>
        {{/limit_reached}}
        
        {{#is_cooldown}}
            <div class="ph-timer badge bg-light text-dark border shadow-sm" 
                 style="position:absolute; bottom:-10px; left:50%; transform:translateX(-50%); font-size:0.6rem;" 
                 data-deadline="{{readytime}}">...</div>
        {{/is_cooldown}}

        {{! Action Link (If active) }}
        {{^limit_reached}}{{^is_cooldown}}
            <a href="{{collect_url}}" 
               class="ph-action-collect ph-hover-scale" 
               style="position:absolute; top:0; left:0; width:100%; height:100%;" 
               aria-label="{{#str}} take, block_playerhud {{/str}}: {{safe_name}}"
               data-mode="image" 
               {{{data_attributes}}}>
            </a>
        {{/is_cooldown}}{{/limit_reached}}
    </div>
{{/is_image_mode}}

{{! --- MODE: CARD (Default) --- }}
{{#is_card}}
    <div class="playerhud-item-card ph-card-compact card p-3 {{#limit_reached}}ph-owned{{/limit_reached}}" 
         style="width: 160px; display:inline-block; vertical-align:top; margin:5px; position: relative;"
         {{{data_attributes}}}>
        
        {{! Badge Count }}
        <span class="badge bg-info text-dark rounded-pill position-absolute ph-badge-count" 
              style="{{^count}}display:none;{{/count}} top:5px; right:5px; font-size:0.7rem;">
              x{{count}}
        </span>

        {{! Icon/Trigger }}
        <div class="ph-item-details-trigger d-flex flex-column align-items-center justify-content-center mb-2" 
             style="cursor: pointer; min-height: 85px;"
             tabindex="0" 
             role="button" 
             aria-label="{{#str}} details, block_playerhud {{/str}}: {{safe_name}}">
             
             <div class="text-center mb-1" style="height: 60px; display: flex; align-items: center; justify-content: center; width: 100%;">
                 {{#is_image_media}}
                    <img src="{{media_url}}" style="max-width:100%; max-height:100%; object-fit:contain;" alt="">
                 {{/is_image_media}}
                 {{^is_image_media}}
                    <div style="font-size:2.5em; line-height:1;" aria-hidden="true">{{{media_content}}}</div>
                 {{/is_image_media}}
             </div>

             <strong class="text-center d-block text-truncate w-100 ph-text-truncate-100" style="font-size: 0.9rem;" aria-hidden="true">
                {{display_name}}
             </strong>
        </div>
        
        {{! Button State }}
        {{#limit_reached}}
            <button disabled class="btn btn-light btn-sm w-100 text-success border-success">
                <i class="fa fa-check" aria-hidden="true"></i> {{#str}} collected, block_playerhud {{/str}}
            </button>
        {{/limit_reached}}
        {{^limit_reached}}
            {{#is_cooldown}}
                <button disabled class="btn btn-light btn-sm w-100 text-muted">
                    ⏳ <span class="ph-timer" data-deadline="{{readytime}}">...</span>
                </button>
            {{/is_cooldown}}
            {{^is_cooldown}}
                <a href="{{collect_url}}" 
                   class="btn btn-primary btn-sm w-100 ph-action-collect shadow-sm mt-2" 
                   data-mode="card">
                   {{{emoji_html}}}{{btn_text}}
                </a>
            {{/is_cooldown}}
        {{/limit_reached}}
    </div>
{{/is_card}}