{{!
    @template filter_playerhud/widget
    Widget displayed by the [PLAYERHUD_WIDGET] shortcode.
}}
<div class="playerhud-widget-container {{level_class}}">
    
    {{! Left: Avatar (Mantido igual) }}
    <div class="ph-widget-left">
        <div class="ph-widget-avatar">
            {{{userpicture}}}
        </div>
    </div>

    {{! Center: Stats & Stash (Mantido igual) }}
    <div class="ph-widget-center">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <div class="d-flex align-items-center">
                <h4 class="m-0 me-2 fw-bold text-dark">{{fullname}}</h4>
                <span class="badge {{level_class}} border shadow-sm px-2">
                    {{#str}} level, filter_playerhud {{/str}} {{level_display}}
                </span>
            </div>
            <div class="small text-muted fw-bold">{{xp_display}}</div>
        </div>

        <div class="ph-progress-container">
            <div class="progress-bar ph-progress-bar {{level_class}}" role="progressbar" 
                 style="width: {{progress}}%;"
                 aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100">
                 <span class="visually-hidden">{{progress}}% {{#str}} completed, core {{/str}}</span>
            </div>
        </div>

        <div class="ph-widget-stash">
            {{#items}}
                <div class="ph-mini-item ph-item-trigger" role="button" tabindex="0"
                     title="{{name}}" aria-label="{{name}}"
                     data-name="{{name}}" data-xp="{{xp}}" data-image="{{image}}"
                     data-isimage="{{isimage}}" data-date="{{date}}">
                     <div class="d-none ph-item-description-content">{{description}}</div>
                     {{#isimage}}<img src="{{image}}" alt="">{{/isimage}}
                     {{^isimage}}<span class="ph-emoji" aria-hidden="true">{{content}}</span>{{/isimage}}
                </div>
            {{/items}}
            {{^items}}
                <span class="small text-muted align-self-center">
                    {{#str}} items, filter_playerhud {{/str}} {{#str}} empty, filter_playerhud {{/str}}
                </span>
            {{/items}}
        </div>
    </div>

{{! Right: Actions Grid (Ordem Padronizada) }}
    <div class="ph-widget-right">
        <div class="ph-widget-actions-grid">
            
            {{! 1. Mochila (Coleção) }}
            <a href="{{url_backpack}}" 
               class="btn btn-ph-level-border shadow-sm" 
               data-bs-toggle="tooltip" data-bs-placement="top" 
               title="{{#str}} openbackpack, filter_playerhud {{/str}}"
               aria-label="{{#str}} openbackpack, filter_playerhud {{/str}}">
                <span aria-hidden="true">🎒</span>
            </a>

            {{! 2. Loja }}
            <a href="{{url_shop}}" 
               class="btn btn-ph-level-border shadow-sm" 
               data-bs-toggle="tooltip" data-bs-placement="top" 
               title="{{#str}} tab_trades, block_playerhud {{/str}}"
               aria-label="{{#str}} tab_trades, block_playerhud {{/str}}">
                <span aria-hidden="true">⚖️</span>
            </a>

            {{! 3. Missões }}
            <a href="{{url_quests}}" 
               class="btn btn-ph-level-border shadow-sm" 
               data-bs-toggle="tooltip" data-bs-placement="top" 
               title="{{#str}} tab_quests, block_playerhud {{/str}}"
               aria-label="{{#str}} tab_quests, block_playerhud {{/str}}">
                <span aria-hidden="true">📜</span>
            </a>
            
            {{! 4. História }}
            <a href="{{url_story}}" 
               class="btn btn-ph-level-border shadow-sm" 
               data-bs-toggle="tooltip" data-bs-placement="bottom" 
               title="{{#str}} story_shortcut, filter_playerhud {{/str}}"
               aria-label="{{#str}} story_shortcut, filter_playerhud {{/str}}">
                <span aria-hidden="true">📖</span>
            </a>

            {{! 5. Ranking }}
            {{#ranking}}
            <a href="{{url}}" 
               class="btn btn-ph-level-border shadow-sm" 
               data-bs-toggle="tooltip" data-bs-placement="bottom" 
               title="#{{rank}} - {{label}}" aria-label="{{label}}">
                <span aria-hidden="true">🏆</span>
                <span class="visually-hidden">{{label}}</span>
            </a>
            {{/ranking}}
            
            {{! Célula vazia (Opcional, para completar o grid se necessário) }}
            
        </div>
    </div>
</div>
{{#js}}
require(["jquery", "theme_boost/tooltip"], function($, Tooltip) {
    $("[data-bs-toggle='tooltip']").tooltip({ boundary: 'window' });
});
{{/js}}