{{!
    @template filter_playerhud/trade

    PlayerHUD trade widget.
    Renders an inline shop offer for students to interact with.
    @package    block_playerhud
    @copyright  2026 Jean Lúcio <jeanlucio@gmail.com>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "trade_name": "Mystic Trade",
        "reqs": [
            { "qty": 3, "name": "Wood", "is_image": false, "content": "🪵" }
        ],
        "rewards": [
             { "qty": 1, "name": "Sword", "is_image": false, "content": "🗡️" }
        ],
        "trade_url": "#",
        "str_trade_btn": "Trade",
        "str_you_pay": "You pay",
        "str_you_receive": "You receive"
    }
}}
<div class="filter_playerhud d-inline-block text-start">
    <div class="card ph-trade-widget-card shadow-sm my-3">
        <div class="card-header bg-light border-bottom text-center py-2">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="fa fa-balance-scale me-1 text-primary" aria-hidden="true"></i> {{trade_name}}
            </h6>
        </div>
        <div class="card-body p-3">

            <div class="row align-items-center">
                <div class="col-5 text-center px-1">
                    <div class="text-danger small fw-bold text-uppercase mb-2 ph-trade-label">
                        <i class="fa fa-minus-circle me-1" aria-hidden="true"></i>{{str_you_pay}}
                    </div>
                    <div class="d-flex flex-column gap-2 align-items-center">
                        {{#reqs}}
                        <div class="badge bg-white text-dark border d-flex align-items-center p-1 pe-2 shadow-sm w-100 text-start" title="{{name}}">
                            <div class="me-2 flex-shrink-0 ph-trade-item-icon rounded-2">
                                {{#is_image}}
                                    <img src="{{url}}" alt="" class="img-fluid w-100 h-100 object-fit-contain rounded-2">
                                {{/is_image}}
                                {{^is_image}}
                                    <span class="ph-emoji-sm" aria-hidden="true">{{{content}}}</span>
                                {{/is_image}}
                            </div>
                            <div class="ph-min-w-0 d-flex flex-column justify-content-center py-1 w-100">
                                <div class="text-truncate lh-1 mb-1">
                                    <span class="fw-bold fs-6">{{qty}}x</span>
                                    <span class="fw-normal">{{name}}</span>
                                </div>
                                <small class="fw-bold {{qty_class}} ph-text-xs lh-1 text-wrap w-100">
                                    {{#str}} trade_you_have, block_playerhud, {{user_qty}} {{/str}}
                                </small>
                            </div>
                        </div>
                        {{/reqs}}
                    </div>
                </div>

                <div class="col-2 text-center text-muted px-0">
                    <i class="fa fa-arrow-right fs-5" aria-hidden="true"></i>
                </div>

                <div class="col-5 text-center px-1">
                    <div class="text-success small fw-bold text-uppercase mb-2 ph-trade-label">
                        <i class="fa fa-plus-circle me-1" aria-hidden="true"></i>{{str_you_receive}}
                    </div>
                    <div class="d-flex flex-column gap-2 align-items-center">
                        {{#rewards}}
                        <div class="badge bg-white text-dark border border-success d-flex align-items-center p-1 pe-2 shadow-sm w-100 text-start" title="{{name}}">
                            <div class="me-2 flex-shrink-0 ph-trade-item-icon success-bg rounded-2">
                                {{#is_image}}
                                    <img src="{{url}}" alt="" class="img-fluid w-100 h-100 object-fit-contain rounded-2">
                                {{/is_image}}
                                {{^is_image}}
                                    <span class="ph-emoji-sm" aria-hidden="true">{{{content}}}</span>
                                {{/is_image}}
                            </div>
                            <div class="text-truncate ph-min-w-0">
                                <span class="fw-bold fs-6">{{qty}}x</span>
                                <span class="fw-normal">{{name}}</span>
                            </div>
                        </div>
                        {{/rewards}}
                    </div>
                </div>
            </div>

            <div class="text-center mt-3 pt-3 border-top">
                {{#can_afford}}
                <a href="{{trade_url}}" class="btn btn-success w-100 fw-bold shadow-sm rounded-3">
                    <i class="fa fa-exchange me-1" aria-hidden="true"></i> {{str_trade_btn}}
                </a>
                {{/can_afford}}
                {{^can_afford}}
                <button class="btn btn-outline-secondary w-100 fw-bold shadow-sm rounded-3" disabled>
                    <i class="fa fa-lock me-1" aria-hidden="true"></i> {{str_missing_items}}
                </button>
                {{/can_afford}}
            </div>
        </div>
    </div>
</div>
