{{!
    @template filter_playerhud/modals

    Modal structure for displaying item details in the filter.
    @package    block_playerhud
    @copyright  2026 Jean Lúcio
    @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "str_congrats": "Congratulations!",
        "str_close": "Close",
        "item_name_placeholder": "Item"
    }
}}
<div class="modal fade ph-z-index-high" id="phItemModalFilter" tabindex="-1" aria-labelledby="phModalTitleF" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">

            <div class="modal-header border-bottom-0 pb-0 d-flex justify-content-between align-items-center">
                <h2 id="phModalTitleF" class="visually-hidden m-0">{{str_congrats}}</h2>

                <button type="button" class="btn-close ph-modal-close-f ms-auto" data-bs-dismiss="modal" data-dismiss="modal" aria-label="{{str_close}}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body pt-0">
                <div class="d-flex align-items-start mb-3">
                    <div id="phModalImageContainerF" class="me-3 text-center ph-modal-img-container"></div>

                    <div class="flex-grow-1 mt-2">
                        <div class="d-flex align-items-center flex-wrap mb-2">
                            <h4 id="phModalNameF" class="m-0 me-2 fw-bold">{{item_name_placeholder}}</h4>
                            <span id="phModalXPF" class="badge bg-primary text-white border shadow-sm ph-display-none">{{#str}} xp, block_playerhud {{/str}}</span>
                        </div>

                        <div id="phModalDescF" class="text-muted text-break mb-3"></div>

                        <div id="phModalDropStatsF" class="d-flex flex-wrap gap-2 mb-3 ph-display-none">
                            <span id="phModalDropProgressF" class="badge bg-dark text-white border shadow-sm"></span>
                            <span id="phModalDropCooldownF" class="badge bg-light text-dark border shadow-sm"></span>
                        </div>

                        <div id="phModalDateContainerF" class="border-top pt-2 mt-3 d-none">
                            <small class="text-success fw-bold">
                                <i class="fa fa-calendar me-1" aria-hidden="true"></i>
                                <span id="phModalDateF"></span>
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">{{str_close}}</button>
            </div>

        </div>
   </div>
</div>
